{
  "name": "github-contributions-api",
  "description": "Scrape contribution data of a GitHub user - Cloudflare Worker edition",
  "version": "5.0.0",
  "author": "Linus Kang",
  "license": "MIT",
  "private": true,
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "prettier -c . && pnpm typecheck && pnpm lint && pnpm test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linuskang/github-contributions-api.git"
  },
  "bugs": {
    "url": "https://github.com/linuskang/github-contributions-api/issues"
  },
  "keywords": [
    "github",
    "contributions",
    "calendar",
    "cloudflare-workers",
    "hono",
    "serverless"
  ],
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.5",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "hono": "^4.13.16",
    "json-stable-stringify": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@eslint/js": "^10.0.1",
    "@tsconfig/bases": "^1.0.28",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  },
  "prettier": {
    "proseWrap": "always",
    "semi": false,
    "singleQuote": true
  }
}
